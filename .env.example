# Copy to .env.local and fill in. Never commit .env.local.

# === App ===
APP_NAME="Laura & Lucien"
VITE_APP_NAME="lulo-wedding"     # used as PostHog "app" property
SITE_URL="http://localhost:3000" # https://lauralucien.com in production
# Same value again: auth/billing read process.env.SITE_URL, but the <head>
# meta tags in __root.tsx read import.meta.env.VITE_SITE_URL, which must be
# baked at build time. Keep the two in sync or og:url/canonical go stale.
VITE_SITE_URL="http://localhost:3000"

# === Secrets (generate with: openssl rand -hex 32) ===
BETTER_AUTH_SECRET=
TOAST_SECRET=                    # ≥32 chars

# === Convex (from `npx convex dev`) ===
VITE_CONVEX_URL=                 # https://xxx.convex.cloud
VITE_CONVEX_SITE_URL=            # https://xxx.convex.site (HTTP actions URL)

# === Guest access ===
# Single shared password for the whole site, including the save-the-date.
# Guests receive it alongside their magic link over WhatsApp.
GUEST_PASSWORD=

# === Admin allowlist ===
# Only these two email addresses may reach /admin. Distinct from
# ADMIN_USER_IDS below, which is the template's better-auth admin plugin
# (user IDs, not emails) and is not what gates /admin here.
ADMIN_EMAILS="lucienkgeorge@gmail.com,laurasahyoun@gmail.com"

# === Resend (transactional email) ===
# lauralucien.com is verified in eu-west-1. Sending does NOT require a
# mailbox to exist at the From address.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Laura & Lucien <hello@lauralucien.com>"
# Signing secret of the Resend webhook pointed at
# https://<deployment>.convex.site/resend-webhook (enable every email.* event).
# Set on the Convex deployment: delivery, open and click tracking for guest email.
RESEND_WEBHOOK_SECRET=

# === Email branding (all optional) ===
EMAIL_LOGO_URL=                  # header logo image URL (falls back to APP_NAME text)
BRAND_COLOR=#9B0D17              # the card's ink red
SUPPORT_EMAIL=                   # help/reply-to address (falls back to RESEND_FROM_EMAIL)
EMAIL_SIGNOFF="— Laura & Lucien"

# === OAuth (Google active, Apple stubbed) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_OAUTH_ENABLED=1   # toggles the "Continue with Google" button in the UI

# === Sentry (optional) ===
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=               # for source map upload during build

# === PostHog (optional) ===
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# === Google Analytics (optional) ===
VITE_GA_MEASUREMENT_ID=          # G-XXXXXXXXXX

# -----------------------------------------------------------------------
# Inherited from tanstack-starter-template and UNUSED by this project.
# The code still ships, so the vars are documented rather than deleted.
# Remove the corresponding features if you want them gone for real.
# -----------------------------------------------------------------------
# OPENAI_API_KEY=                # AI SDK / RAG
# ADMIN_USER_IDS=                # better-auth admin plugin (user IDs)
# POLAR_ACCESS_TOKEN=            # billing
# POLAR_WEBHOOK_SECRET=
# POLAR_ORGANIZATION_ID=
# POLAR_PRODUCT_STARTER=
# POLAR_PRODUCT_PRO=
# POLAR_SERVER=production
# BILLING_PROVIDER=polar
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
