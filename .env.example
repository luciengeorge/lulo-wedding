# Copy to .env.local and fill in. Never commit .env.local.

# === App ===
APP_NAME="My App"
VITE_APP_NAME="my-app"           # used as PostHog "app" property
SITE_URL="http://localhost:3000"

# === Secrets (generate with: openssl rand -hex 32) ===
BETTER_AUTH_SECRET=
TOAST_SECRET=                    # ≥32 chars

# === Convex (from `npx convex dev`) ===
VITE_CONVEX_URL=                 # https://xxx.convex.cloud
VITE_CONVEX_SITE_URL=            # https://xxx.convex.site (HTTP actions URL)

# === OpenAI ===
OPENAI_API_KEY=

# === Resend (transactional email) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=               # noreply@yourdomain.com — must be a verified domain

# === Email branding (all optional) ===
EMAIL_LOGO_URL=                  # header logo image URL (falls back to APP_NAME text)
BRAND_COLOR=                     # hex for buttons/accents, e.g. #4f46e5 (default #0a0a0a)
SUPPORT_EMAIL=                   # help/reply-to address (falls back to RESEND_FROM_EMAIL)
EMAIL_SIGNOFF=                   # signature line, e.g. "— Lucien, founder of MyApp"

# === Polar (billing — Merchant of Record) ===
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_STARTER=           # Polar product ID for the Starter plan
POLAR_PRODUCT_PRO=               # Polar product ID for the Pro plan
POLAR_SERVER=production          # production | sandbox
BILLING_PROVIDER=polar           # polar | stripe (stripe adapter stubbed)

# === Stripe (only if BILLING_PROVIDER=stripe) ===
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# === Admin / impersonation ===
# Comma-separated list of user IDs (NOT emails) granted admin powers.
# Sign up first → look up your _id from the Convex dashboard → paste here → restart.
ADMIN_USER_IDS=

# === OAuth (Google active in V1, Apple stubbed) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_OAUTH_ENABLED=1   # toggles the "Continue with Google" button in the UI
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_BUNDLE_ID=
# VITE_APPLE_OAUTH_ENABLED=1

# === Sentry (optional) ===
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=               # for source map upload during build

# === PostHog (optional) ===
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# === Google Analytics (optional) ===
VITE_GA_MEASUREMENT_ID=          # G-XXXXXXXXXX
