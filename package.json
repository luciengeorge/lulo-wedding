{
  "name": "tanstack-starter-template",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "predev": "test -d convex/_generated && pnpm auth:generate || true",
    "convex": "convex dev",
    "preconvex": "test -d convex/_generated && pnpm auth:generate || true",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts -y",
    "auth:check": "pnpm auth:generate && git diff --exit-code -- convex/betterAuth/schema.ts",
    "build": "vite build && if [ -d .output/server ]; then cp instrument.server.mjs .output/server; fi",
    "preview": "vite preview",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "email:dev": "email dev --dir ./convex/email/templates --port 3001",
    "email:export": "email export --dir ./convex/email/templates --outDir ./.email-out",
    "test": "vitest run",
    "lint": "oxfmt src && oxlint src",
    "lint:check": "oxfmt --check src && oxlint src",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/react": "^4.0.96",
    "@base-ui/react": "^1.8.0",
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/better-auth": "0.12.3",
    "@convex-dev/polar": "^0.9.2",
    "@convex-dev/rag": "^0.7.6",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@posthog/react": "^1.10.6",
    "@react-email/components": "^1.0.12",
    "@sentry/tanstackstart-react": "^10.73.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.50",
    "@tanstack/router-plugin": "^1.168.36",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.93",
    "better-auth": "~1.6.30",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "openai": "^7.10.0",
    "posthog-js": "^1.428.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.3",
    "resend": "^6.26.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "^0.149.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "web-vitals": "^6.2.1"
  }
}
