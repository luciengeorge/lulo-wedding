{
  "name": "tanstack-starter-template",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "predev": "test -d convex/_generated && pnpm auth:generate || true",
    "convex": "convex dev",
    "preconvex": "test -d convex/_generated && pnpm auth:generate || true",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --config convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts -y",
    "auth:check": "pnpm auth:generate && git diff --exit-code -- convex/betterAuth/schema.ts",
    "build": "vite build && if [ -d .output/server ]; then cp instrument.server.mjs .output/server; fi",
    "preview": "vite preview",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "email:dev": "email dev --dir ./convex/email/templates --port 3001",
    "email:export": "email export --dir ./convex/email/templates --outDir ./.email-out",
    "test": "vitest run",
    "lint": "oxfmt src e2e scripts && oxlint src e2e scripts",
    "lint:check": "oxfmt --check src e2e scripts && oxlint src e2e scripts",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "tsgo --noEmit",
    "e2e": "playwright test",
    "e2e:dev": "E2E_DEV=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:backend": "node scripts/e2e/backend.mjs",
    "e2e:app": "dotenv -e .env.e2e -- vite dev --mode e2e --host 127.0.0.1 --port 3100 --strictPort",
    "e2e:serve": "node scripts/e2e/serve-app.mjs",
    "e2e:clean": "node scripts/e2e/backend.mjs --clean"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/react": "^4.0.147",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/polar": "^0.9.2",
    "@convex-dev/rag": "^0.7.8",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/resend": "^0.2.9",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@posthog/react": "^1.11.3",
    "@sentry/tanstackstart-react": "^11.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/router-plugin": "^1.168.47",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.143",
    "better-auth": "1.6.33",
    "change-case": "^5.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "iron-webcrypto": "^2.0.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "openai": "^7.38.0",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "resend": "^6.34.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "spin-delay": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "6.11.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.62",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.154.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-vitals": "^6.2.3"
  }
}
