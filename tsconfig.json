{
  "include": ["**/*.ts", "**/*.tsx"],
  // TypeScript does not skip dot-directories, so without this the E2E mirror in
  // .e2e/app is compiled as a second copy of the whole app: twice the work, and a
  // stale mirror would fail the typecheck on code that is already fixed here.
  "exclude": ["node_modules", ".e2e", ".output", ".nitro", ".tanstack", ".vercel"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true
  }
}
